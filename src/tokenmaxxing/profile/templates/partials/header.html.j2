<aside class="profile-rail" aria-label="Profile">
  <p class="wordmark">tokenmaxxing</p>
  {% if profile.avatar %}
  <img class="avatar" src="{{ profile.avatar }}" alt="{{ profile.name }}">
  {% else %}
  <div class="avatar avatar-fallback" aria-hidden="true">{{ profile.name[:1]|upper }}</div>
  {% endif %}
  <h2 class="profile-name">{{ profile.name }}</h2>
  {% if profile.bio %}<p class="profile-bio">{{ profile.bio }}</p>{% endif %}
  {% if profile.links %}
  <ul class="profile-links">
    {% for link in profile.links %}
    <li>
      <a href="{{ link.url }}">
        {% if link.label == "LinkedIn" %}
        <svg class="profile-link-icon icon-linkedin" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.5 8.3H3.2V19h3.3V8.3ZM4.85 3A1.93 1.93 0 1 0 4.85 6.86 1.93 1.93 0 0 0 4.85 3ZM19 12.87c0-3.22-1.72-4.72-4.02-4.72-1.85 0-2.68 1.02-3.14 1.74V8.3H8.55V19h3.29v-5.3c0-1.4.27-2.77 2.01-2.77 1.72 0 1.74 1.61 1.74 2.86V19H19v-6.13Z"/></svg>
        {% elif link.label == "GitHub" %}
        <svg class="profile-link-icon icon-github" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.88c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.82a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.86v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
        {% else %}
        <svg class="profile-link-icon icon-website" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.3 2.45 3.5 5.45 3.5 9s-1.2 6.55-3.5 9c-2.3-2.45-3.5-5.45-3.5-9S9.7 5.45 12 3Z"/></svg>
        {% endif %}
        <span>{{ link.value }}</span>
        <span class="visually-hidden"> — {{ link.label }}</span>
      </a>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if awards %}
  <section class="profile-awards" aria-labelledby="awards-title">
    <h3 id="awards-title">Awards</h3>
    <div class="awards-list">{% for award in awards %}<button class="award-medal award-{{ award.modifier }}" style="--award-index: {{ loop.index0 }}" type="button" aria-describedby="award-detail-{{ loop.index }}" aria-expanded="false" aria-label="{{ award.name }}. {{ award.description }} {{ award.metric }}.{% if award.earned_on %} Earned {{ award.earned_on|date }}.{% endif %}"><svg class="award-art" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><use href="assets/icons/awards.svg#award-{{ award.modifier }}"></use></svg><span class="award-copy" aria-hidden="true"><span class="award-name">{{ award.name }}</span><span class="award-summary">{{ award.metric }}</span></span><span class="award-tooltip" id="award-detail-{{ loop.index }}" role="tooltip"><strong>{{ award.name }}</strong><span>{{ award.description }}</span><span class="award-metric">{{ award.metric }}{% if award.earned_on %} · {{ award.earned_on|date }}{% endif %}</span></span></button>{% endfor %}</div>
  </section>
  {% endif %}
</aside>
